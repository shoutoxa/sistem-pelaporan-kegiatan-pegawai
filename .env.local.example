# Copy to .env.local AFTER starting Supabase locally. Never copy cloud keys here.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=
STORAGE_BUCKET=dokumentasi-laporan
SEED_ADMIN_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
FTTH_API_BASE_URL=https://ftth.digitak.id/ftth_api/integration
FTTH_API_KEY=
# Keep false until local migrations, seed, storage and FTTH user mappings are ready.
FTTH_REPORTS_ENABLED=false
