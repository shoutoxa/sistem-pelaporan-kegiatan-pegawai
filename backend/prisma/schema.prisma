generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPERADMIN
  PEGAWAI
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  nama         String
  username     String        @unique
  passwordHash String        @map("password_hash")
  role         Role
  isActive     Boolean       @default(true) @map("is_active")
  wajibLapor   Boolean       @default(false) @map("wajib_lapor")
  nomorHp      String?       @map("nomor_hp") @db.VarChar(20)
  fotoProfil   String?       @map("foto_profil") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  laporan      Laporan[]
  ftthIdentity FtthIdentity?

  @@map("users")
}

// Temporary explicit development mapping. Never used to authenticate an FTTH account.
model FtthIdentity {
  userId            String   @id @map("user_id") @db.Uuid
  externalUserId    String   @unique @map("external_user_id") @db.Uuid
  allowedClusterIds String[] @default([]) @map("allowed_cluster_ids") @db.Uuid
  updatedAt         DateTime @updatedAt @map("updated_at")
  user              User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("ftth_identity")
}

// Recovery journal for non-transactional Storage + FTTH attachment writes.
model FtthUpload {
  remotePath   String? @map("remote_path")
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @map("report_id") @db.Uuid
  storagePath  String   @unique @map("storage_path")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  state        String   @default("PREPARED")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([reportId])
  @@map("ftth_upload")
}

model Desa {
  id        String    @id @default(uuid()) @db.Uuid
  namaDesa  String    @unique @map("nama_desa")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  clusters  Cluster[]

  @@map("desa")
}

model Cluster {
  id          String    @id @default(uuid()) @db.Uuid
  desaId      String    @map("desa_id") @db.Uuid
  clusterName String    @map("cluster_name")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  desa        Desa      @relation(fields: [desaId], references: [id], onDelete: Restrict)
  laporan     Laporan[]

  @@unique([desaId, clusterName])
  @@index([desaId, isActive])
  @@map("cluster")
}

model Pekerjaan {
  id                   String             @id @default(uuid()) @db.Uuid
  namaPekerjaan        String             @unique @map("nama_pekerjaan")
  kategoriId           String?            @map("kategori_id") @db.Uuid
  externalId           String?            @unique @map("external_id") @db.Uuid
  sumber               String             @default("LOCAL") @db.VarChar(30)
  sortOrder            Int?               @map("sort_order")
  allowFile            Boolean            @default(true) @map("allow_file")
  allowText            Boolean            @default(true) @map("allow_text")
  allowLink            Boolean            @default(false) @map("allow_link")
  instruksiDokumentasi String?            @map("instruksi_dokumentasi")
  isActive             Boolean            @default(true) @map("is_active")
  lastSyncedAt         DateTime?          @map("last_synced_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  kategori             KategoriPekerjaan? @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  laporan              Laporan[]

  @@index([isActive])
  @@index([kategoriId, isActive])
  @@map("pekerjaan")
}

model KategoriPekerjaan {
  id           String      @id @default(uuid()) @db.Uuid
  externalId   String?     @unique @map("external_id") @db.Uuid
  namaKategori String      @unique @map("nama_kategori")
  deskripsi    String?
  sumber       String      @default("LOCAL") @db.VarChar(30)
  isActive     Boolean     @default(true) @map("is_active")
  lastSyncedAt DateTime?   @map("last_synced_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  pekerjaan    Pekerjaan[]

  @@index([isActive])
  @@map("kategori_pekerjaan")
}

model Laporan {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  clusterId       String        @map("cluster_id") @db.Uuid
  pekerjaanId     String        @map("pekerjaan_id") @db.Uuid
  tanggalKegiatan DateTime      @map("tanggal_kegiatan") @db.Date
  keterangan      String
  nomorPerangkat  String?       @map("nomor_perangkat")
  diterima        Boolean       @default(false) @map("diterima")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  cluster         Cluster       @relation(fields: [clusterId], references: [id], onDelete: Restrict)
  pekerjaan       Pekerjaan     @relation(fields: [pekerjaanId], references: [id], onDelete: Restrict)
  dokumentasi     Dokumentasi[]

  @@index([userId, tanggalKegiatan])
  @@index([tanggalKegiatan])
  @@index([clusterId])
  @@index([pekerjaanId])
  @@map("laporan")
}

model Dokumentasi {
  id           String   @id @default(uuid()) @db.Uuid
  laporanId    String   @map("laporan_id") @db.Uuid
  storagePath  String   @unique @map("storage_path")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  createdAt    DateTime @default(now()) @map("created_at")
  laporan      Laporan  @relation(fields: [laporanId], references: [id], onDelete: Restrict)

  @@index([laporanId])
  @@map("dokumentasi")
}
